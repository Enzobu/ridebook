meta {
  name: Register with invitation
  type: http
  seq: 5
}

post {
  url: {{apiUrl}}/api/v1/auth/register
  body: json
}

body:json {
  {
    "email": "user@example.com",
    "password": "RidebookTest1!",
    "token": "invitation-token"
  }
}

docs {
  Crée un compte utilisateur depuis une invitation valide, non expirée et non utilisée.
  Le mot de passe doit faire au moins 12 caractères et contenir une majuscule, une minuscule, un chiffre et un caractère spécial.
}

tests {
  expect([201, 400, 404, 409, 410]).to.include(res.status);
}
