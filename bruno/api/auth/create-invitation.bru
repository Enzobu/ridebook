meta {
  name: Create invitation
  type: http
  seq: 6
}

post {
  url: {{apiUrl}}/api/v1/invitations
  body: json
}

body:json {
  {
    "email": "user@example.com"
  }
}

docs {
  Crée une invitation liée à un email et envoie immédiatement le lien d'inscription à ce destinataire. Route réservée aux administrateurs.
}

tests {
  expect([201, 400, 401, 403, 409, 503]).to.include(res.status);
}
