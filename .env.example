# Runtime
NODE_ENV=development
COMPOSE_PROJECT_NAME=ridebook

# Public URLs
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000

# Published host ports
FRONTEND_PORT=3000
API_PORT=3001

# Database
MARIADB_DATABASE=ridebook
MARIADB_USER=ridebook
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-root-me
DATABASE_URL=mysql://ridebook:change-me@database:3306/ridebook
DB_VOLUME_PATH=./.data/mariadb

# Authentication
JWT_ACCESS_SECRET=change-access-secret
JWT_REFRESH_SECRET=change-refresh-secret
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Initial admin CLI
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-admin-password

# Mail / OVH SMTP
ADMIN_NOTIFICATION_EMAIL=admin@example.com
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Ridebook <no-reply@example.com>

# Selenium / maps worker
SELENIUM_HEADLESS=true
SELENIUM_TIMEOUT_MS=60000
SELENIUM_MAX_ATTEMPTS=3
SELENIUM_SCREENSHOT_DIR=/storage/selenium-errors
SELENIUM_SCREENSHOT_VOLUME_PATH=./.data/selenium-errors
WORKER_POLL_INTERVAL_MS=5000
WORKER_STALLED_JOB_TIMEOUT_MINUTES=15
