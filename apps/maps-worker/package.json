{
  "name": "maps-worker",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "pnpm run prisma:generate && tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "lint": "pnpm run prisma:generate && tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "test": "pnpm run prisma:generate && vitest run --passWithNoTests",
    "test:e2e": "pnpm run prisma:generate && vitest run --passWithNoTests",
    "prisma:generate": "prisma generate --schema ../api/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "nodemailer": "^9.0.3",
    "selenium-webdriver": "^4.46.0",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/nodemailer": "^8.0.1",
    "@types/selenium-webdriver": "^4.35.6",
    "prisma": "^6.14.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
